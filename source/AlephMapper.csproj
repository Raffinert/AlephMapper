<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Analyzer.Shared.props" />

  <PropertyGroup>
    <Authors>Yevhen Cherkes</Authors>
    <Copyright>Copyright 2025 - $([System.DateTime]::Now.Year) Yevhen Cherkes</Copyright>
    <Description>Your manual mapping companion.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DefineConstants>$(DefineConstants);ALEPHMAPPER_ROSLYN5</DefineConstants>
    <PackageId>AlephMapper</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Raffinert/AlephMapper</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Mapping Companion</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Raffinert/AlephMapper.git</RepositoryUrl>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <Title>Aleph Mapper</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/roslyn5.0/cs/$(AssemblyName).dll" Visible="false" />
    <None Include="Roslyn4/bin/$(Configuration)/netstandard2.0/AlephMapper.dll" Pack="true" PackagePath="analyzers/dotnet/roslyn4.8/cs/AlephMapper.dll" Visible="false" />
    <Compile Remove="Roslyn4/**" />
    <ProjectReference Include="Roslyn4/AlephMapper.Roslyn4.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../README.md" pack="true" PackagePath="." />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Attributes.cs" />
    </ItemGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="AlephMapper.Tests" />
    </ItemGroup>

</Project>
